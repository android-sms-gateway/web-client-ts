# ==================================================
# SERVER CONFIGURATION
# ==================================================

# Port the server will listen on
# Default: 3000
# Example: 3000
HTTP__PORT=3000

# Fallback port (used if HTTP__PORT is not set)
# Default: 3000
# Example: 3000
PORT=3000

# Secret key for session management
# WARNING: In production, this MUST be set to a strong, random value
# Default: Auto-generated (32 random bytes in hex) in development
# Example: 'a1b2c3d4e5f67890a1b2c3d4e5f67890a1b2c3d4e5f67890a1b2c3d4e5f67890'
HTTP__SESSION_SECRET=

# ==================================================
# SMS GATEWAY INTEGRATION
# ==================================================

# Base URL for the SMS gateway API
# Default: 'https://api.sms-gate.app/3rdparty/v1'
# Example: 'https://api.sms-gate.app/3rdparty/v1'
GATEWAY__URL=https://api.sms-gate.app/3rdparty/v1

# URL where the gateway will send webhook notifications (REQUIRED)
# Must be a publicly reachable HTTPS URL in production
# HTTP is only allowed in development mode (NODE_ENV=development)
# Example: 'https://your-domain.com/api/webhooks'
GATEWAY__WEBHOOK_URL=https://your-domain.com/api/webhooks

# ==================================================
# APPLICATION ENVIRONMENT
# ==================================================

# Sets the application environment (development, production, etc.)
# Affects debug mode and other environment-specific behaviors
# Default: 'development'
# Example: 'production'
NODE_ENV=development
